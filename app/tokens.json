{
  "$comment": "Machine-readable mirror of styles.css. styles.css is the source of truth — keep in sync by hand.",

  "color": {
    "adjustable_ui": {
      "c1": { "value": "#D95F27", "role": "primary — actions, active tab, Feed button, ring progress" },
      "c2": { "value": "#4E8B3D", "role": "secondary — healthy state, fills, switches, OK chips" },
      "c3": { "value": "#B58A12", "role": "accent — attention, tags, warning dots, banners" }
    },
    "adjustable_material": {
      "feed": { "value": "#8A5A2B", "role": "the grain in the barrel — a substance, not a UI role" }
    },
    "fixed": {
      "crit": { "light": "#C23A2C", "dark": "#E5604E", "role": "danger only — deliberately not re-skinnable" }
    },
    "neutral": {
      "light": {
        "bg": "#E9EAE2", "surface": "#FBFBF6", "surface-2": "#F1F2EA", "surface-3": "#E8EADF",
        "ink": "#191C13", "ink-2": "#565C49", "ink-3": "#878D75",
        "line": "#D6D9C8", "line-2": "#C7CBB6"
      },
      "dark": {
        "bg": "#0C0E09", "surface": "#181B12", "surface-2": "#20241A", "surface-3": "#282D1F",
        "ink": "#EEEFE4", "ink-2": "#A2A891", "ink-3": "#71785F",
        "line": "#2C3122", "line-2": "#3A4030"
      }
    },
    "derivation": {
      "hi": "color-mix(in oklab, <c> 82%, #000)   /* dark: 78%, #fff */",
      "wash": "color-mix(in oklab, <c> 13%, surface)  /* dark: 20% */",
      "feed-lo": "color-mix(in oklab, feed 68%, #fff)  /* dark: 62%, #000 */",
      "on": "computed in app.js from WCAG luminance; >0.42 -> #191C13, else #FFFFFF"
    }
  },

  "state": {
    "level-feed": { "type": "number 0-1", "default": 0.72, "drives": "barrel fill translate" },
    "level-batt": { "type": "number 0-1", "default": 0.82, "drives": "battery fill scaleX" },
    "thresholds": {
      "$comment": "Defined in app.js, applied as data-feed / data-batt attributes.",
      "FEED_LOW": 25, "FEED_EMPTY": 8, "BATT_LOW": 40, "BATT_CRIT": 20
    },
    "attributes": {
      "data-feed": ["ok", "low", "empty"],
      "data-batt": ["ok", "low", "crit"],
      "data-theme": ["light", "dark"]
    }
  },

  "radius": { "r": "16px", "r-sm": "11px", "r-xs": "8px", "r-pill": "999px" },
  "space":  { "s1": "4px", "s2": "8px", "s3": "12px", "s4": "16px", "s5": "24px" },

  "type": {
    "family": {
      "sans": "system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif",
      "mono": "ui-monospace, SF Mono, Cascadia Mono, Menlo, Consolas, monospace"
    },
    "scale": {
      "t-xs": "11px   — section labels, hints, tags, tab bar",
      "t-sm": "12.5px — secondary body, key/value rows",
      "t-md": "14px   — body, control labels",
      "t-lg": "17px   — card titles, ring centre, sub-screen titles",
      "t-xl": "22px   — top bar title",
      "t-2xl": "30px  — stat values"
    }
  },

  "motion": {
    "ease": "cubic-bezier(.4,0,.2,1)",
    "fast": "0.18s — color, background",
    "base": "0.22s — switch travel",
    "slow": "0.5-0.6s — bar fills, ring progress, barrel level"
  },

  "artboard": { "width": 390, "height": 844, "radius": 44 },

  "screens": [
    { "n": 1,  "name": "System overview",        "group": "everyday", "nav": "tab" },
    { "n": 2,  "name": "Overview — empty state", "group": "everyday", "nav": "tab" },
    { "n": 3,  "name": "Automatic feeding",      "group": "everyday", "nav": "tab" },
    { "n": 4,  "name": "Location / GNSS search", "group": "everyday", "nav": "tab" },
    { "n": 5,  "name": "Menu",                   "group": "everyday", "nav": "tab" },
    { "n": 6,  "name": "Calibration",            "group": "device",   "nav": "menu > Device" },
    { "n": 7,  "name": "Persons",                "group": "people",   "nav": "menu > People" },
    { "n": 8,  "name": "Personal data",          "group": "people",   "nav": "menu > People" },
    { "n": 9,  "name": "System data",            "group": "device",   "nav": "menu > Device" },
    { "n": 10, "name": "Language & appearance",  "group": "app",      "nav": "menu > App" },
    { "n": 11, "name": "Developer login",        "group": "dev",      "nav": "menu > Advanced" },
    { "n": 12, "name": "Dev · Power",            "group": "dev",      "nav": "dev tab" },
    { "n": 13, "name": "Dev · Terminal",         "group": "dev",      "nav": "dev tab" },
    { "n": 14, "name": "Dev · Memory",           "group": "dev",      "nav": "dev tab" },
    { "n": 15, "name": "Dev · Logs",             "group": "dev",      "nav": "dev tab" },
    { "n": 16, "name": "Dev · Faults",           "group": "dev",      "nav": "dev tab" }
  ]
}
